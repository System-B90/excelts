{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023"],
        "types": ["node"],
        "esModuleInterop": true,
        "useDefineForClassFields": false,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "strict": true
    },
    "include": ["src"]
}
