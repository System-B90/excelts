{
    "name": "@system-b90/excelts",
    "version": "1.0.0",
    "description": "Read, write and stream Excel spreadsheets (XLSX) and CSV in Node.js. Zero dependencies, fully typed.",
    "license": "MIT",
    "author": "System-B90",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/System-B90/excelts.git"
    },
    "homepage": "https://github.com/System-B90/excelts#readme",
    "bugs": {
        "url": "https://github.com/System-B90/excelts/issues"
    },
    "keywords": [
        "excel",
        "xlsx",
        "csv",
        "spreadsheet",
        "workbook",
        "worksheet",
        "streaming",
        "zero-dependency",
        "typescript"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "node scripts/build.mjs",
        "pretest": "npm run build",
        "test": "node --test",
        "test:update-snapshots": "npm run build && node scripts/update-snapshots.mjs",
        "test:types": "tsc -p tests/types/tsconfig.json && tsc -p tests/types/tsconfig.bundler.json && tsc -p tests/types/tsconfig.node10.json",
        "test:turbopack": "node scripts/check-turbopack.mjs",
        "audit:bundle": "node scripts/audit-bundle.mjs",
        "prepublishOnly": "npm test && npm run test:types"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "archiver": "5.3.2",
        "dayjs": "1.11.23",
        "esbuild": "0.28.2",
        "fast-csv": "4.3.6",
        "jszip": "3.10.2",
        "readable-stream": "3.6.2",
        "saxes": "5.0.1",
        "typescript": "^5.9.3",
        "unzipper": "0.10.14",
        "uuid": "8.3.2"
    }
}
